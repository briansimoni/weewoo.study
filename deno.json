{
  "unstable": [
    "kv",
    "cron"
  ],
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check",
    "verify": "deno task check && deno task test",
    "smoke": "deno run --allow-net scripts/smoke.ts",
    "admin": "deno run --allow-net --allow-read --allow-env scripts/admin_api.ts",
    "seed": "deno run --allow-read --allow-write --allow-env=STAGE --unstable-kv scripts/seed.ts",
    "dev": "vite",
    "start": "deno serve -A --unstable-kv --unstable-cron _fresh/server.js",
    "build": "vite build",
    "preview": "deno task start",
    "update": "deno run -A -r jsr:@fresh/update@2.3.3 .",
    "test": "deno test --allow-env=DENO_DEPLOYMENT_ID,GITHUB_SHA,CI_COMMIT_SHA,STAGE --ignore=image-converter,node_modules,.deno_cache",
    "e2e:serve": "rm -f .kv/e2e.sqlite3 .kv/e2e.sqlite3-shm .kv/e2e.sqlite3-wal && deno run --allow-read --allow-write --allow-env=STAGE --unstable-kv scripts/seed.ts .kv/e2e.sqlite3 && KV_PATH=.kv/e2e.sqlite3 STAGE=DEV deno serve -A --unstable-kv --unstable-cron --port 8123 _fresh/server.js",
    "e2e": "deno task build && deno run -A npm:@playwright/test@1.63.0 test -c e2e/playwright.config.ts",
    "e2e:remote": "deno run -A npm:@playwright/test@1.63.0 test -c e2e/playwright.config.ts",
    "e2e:install": "deno run -A npm:playwright@1.63.0 install chromium"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*",
    "image-converter/**/*",
    "vite.config.ts.timestamp-*.mjs",
    ".deno_cache/"
  ],
  "nodeModulesDir": "auto",
  "imports": {
    "@aws-sdk/client-ses": "npm:@aws-sdk/client-ses@3.863.0",
    "@deno-library/logger": "jsr:@deno-library/logger@^1.1.9",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@1.1.2",
    "@openai/openai": "jsr:@openai/openai@^4.102.0",
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@std/csv": "jsr:@std/csv@^1.0.5",
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@std/http": "jsr:@std/http@^1.0.13",
    "@std/testing": "jsr:@std/testing@^1.0.9",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.1.12",
    "chart.js": "npm:chart.js@^4.5.0",
    "cron-time-generator": "npm:cron-time-generator@^2.0.3",
    "dayjs": "npm:dayjs@^1.11.13",
    "dayjs-plugin-utc": "npm:dayjs-plugin-utc@^0.1.2",
    "jszip": "npm:jszip@^3.10.1",
    "preact": "npm:preact@^10.29.1",
    "preact-render-to-string": "npm:preact-render-to-string@^6.7.0",
    "lucide-preact": "npm:lucide-preact@^0.477.0",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.6",
    "microdiff": "npm:microdiff@^1.0.0",
    "sharp": "npm:sharp@^0.34.3",
    "stripe": "npm:stripe@22.0.1",
    "tailwindcss": "npm:tailwindcss@4.1.12",
    "daisyui": "npm:daisyui@5.0.27",
    "vite": "npm:vite@7.3.6",
    "zod": "npm:zod@^3.24.2",
    "@aws-sdk/client-s3": "npm:@aws-sdk/client-s3@3.797.0",
    "@aws-sdk/client-sqs": "npm:@aws-sdk/client-sqs@3.797.0",
    "@codemirror/commands": "npm:@codemirror/commands@^6.8.1",
    "@codemirror/language": "npm:@codemirror/language@^6.11.3",
    "@codemirror/lang-json": "npm:@codemirror/lang-json@^6.0.2",
    "@codemirror/state": "npm:@codemirror/state@^6.5.2",
    "@codemirror/theme-one-dark": "npm:@codemirror/theme-one-dark@^6.1.3",
    "@codemirror/view": "npm:@codemirror/view@^6.38.6",
    "winston": "npm:winston@^3.12.0",
    "winston-cloudwatch": "npm:winston-cloudwatch@^6.2.0",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "oauth4webapi": "npm:oauth4webapi@^3.6.1",
    "@playwright/test": "npm:@playwright/test@1.63.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": [
      "vite/client"
    ],
    "lib": [
      "deno.unstable",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ]
  },
  "deploy": {
    "org": "briansimoni",
    "app": "weewoo-study"
  }
}
