# Copy to .env and fill in. Descriptions are in README.md ("Environment variables").
# Use test-mode / non-production credentials for local development.

# Core
STAGE=DEV
LOG_LEVEL=debug
# Local test data: `deno task seed`, then KV_PATH=.kv/seed.sqlite3
KV_PATH=
# Deploy: seed empty branch databases on startup (ignored when STAGE=PROD)
SEED_ON_EMPTY=
# Admin API: ADMIN_API_TOKEN is set on the Deploy apps; the WEEWOO_ tokens
# are local, for `deno task admin` (see README)
ADMIN_API_TOKEN=
WEEWOO_ADMIN_TOKEN_TEST=
WEEWOO_ADMIN_TOKEN_PROD=
CLIENT_ID=
CLIENT_SECRET=

# Email and support
ADMIN_EMAIL=
SES_FROM_EMAIL=
RECAPTCHA_SECRET_KEY=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
WEEWOO_OPS_QUEUE_URL=

# Commerce (Stripe test mode keys locally)
STRIPE_API_KEY=
STRIPE_SIGNING_SECRET=
PRINTFUL_SECRET=
# Outside PROD the Stripe webhook only logs orders; true submits Printful drafts
PRINTFUL_DRAFT_ORDERS=

# Question generation and content scripts
CHAT_GPT_KEY=
S3_BUCKET_NAME=
S3_PREFIX_KEY=

# Image migration script
S3_IMAGES_BUCKET=
CLOUDFRONT_URL=
