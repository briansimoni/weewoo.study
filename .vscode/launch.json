{
  "version": "0.2.0",

  "configurations": [
    {
      "name": "Attach to Deno",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "cwd": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "routes/*": "${workspaceFolder}/routes/*",
        "lib/*": "${workspaceFolder}/lib/*",
        "islands/*": "${workspaceFolder}/islands/*",
        "components/*": "${workspaceFolder}/components/*"
      }
    },
    {
      "name": "Start And Debug Deno Server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "runtimeExecutable": "deno",
      "runtimeArgs": [
        "run",
        "--inspect-wait",
        "-A",
        "--unstable-kv",
        "--unstable-cron"
      ],
      "attachSimplePort": 9229,
      "outputCapture": "std",
      "env": {
        "DENO_DIR": "${workspaceFolder}/.deno_cache",
        "STAGE": "DEV"
      },
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "sourceMapPathOverrides": {
        "routes/*": "${workspaceFolder}/routes/*",
        "lib/*": "${workspaceFolder}/lib/*",
        "islands/*": "${workspaceFolder}/islands/*",
        "components/*": "${workspaceFolder}/components/*"
      },
      "console": "integratedTerminal"
    }
  ]
}
